PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Leave empty or set to your MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/nova_ai_chatbot

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_nova_ai_2026_change_in_production
JWT_EXPIRE=7d

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ImageKit Configuration (Get from https://imagekit.io/dashboard)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
